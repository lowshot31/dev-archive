<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Portal Dashboard</masterLabel>
    <description>Displays Orders, Cases, and Contracts for the user.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Account ID (Optional)"
                description="Pass an Account ID if needed, otherwise uses user's contact account." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>