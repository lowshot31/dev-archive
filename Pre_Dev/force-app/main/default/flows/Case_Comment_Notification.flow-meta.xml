<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>댓글이 달리면 알림이 갑니다</description>
        <name>Copy_1_of_Send_Comment_Notification</name>
        <label>Copy 1 of Send Comment Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipientAddresses</name>
            <value>
                <collectionElements>
                    <elementReference>Get_Case_Info.Contact.Email</elementReference>
                </collectionElements>
            </value>
        </inputParameters>
        <inputParameters>
            <name>composeEmailContent</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>CommentTemplate</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>안녕하세요, 

케이스 #{!Get_Case_Info.CaseNumber}에 새로운 댓글이 달렸습니다! 

제목: {!Get_Case_Info.Subject} 

메세지 : {!$Record.CommentBody} 포탈에서 확인해주세요!</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>2.0.1</versionString>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>댓글 작성자 ≠ 케이스 연락처
내부 직원이 쓴 경우만 True</description>
        <name>Check_if_Internal_User</name>
        <label>Check if Internal User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Internal_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CreatedBy.ContactId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Case_Info.ContactId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Send_Comment_Notification</targetReference>
            </connector>
            <label>Is Internal User</label>
        </rules>
    </decisions>
    <description>케이스에 댓글이 달면 유저의 이메일에 알림</description>
    <environments>Default</environments>
    <interviewLabel>Case Comment Notification {!$Flow.CurrentDateTime}</interviewLabel>
