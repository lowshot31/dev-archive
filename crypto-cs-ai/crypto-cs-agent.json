      "parameters": {
        "jsCode": "const text = $json.raw_text || $json.masked || '';\n\n// 1. EVM 해시 (0x + 64자리 hex)\nconst evmMatch = text.match(/0x[a-fA-F0-9]{64}/);\nif (evmMatch) {\n  return [{ json: { ...$json, prefill_txid: evmMatch[0] } }];\n}\n\n// 2. Non-EVM 해시 (공백 또는 텍스트 경계로 구분된 40~88자리 영숫자)\nconst nonEvmMatch = text.match(/(?:^|\\s)([a-zA-Z0-9]{40,88})(?:\\s|$)/);\nif (nonEvmMatch) {\n  return [{ json: { ...$json, prefill_txid: nonEvmMatch[1] } }];\n}\n\n// 3. 못 찾으면 null\nreturn [{ json: { ...$json, prefill_txid: null } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3568,
