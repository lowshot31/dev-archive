    },
    {
      "parameters": {
        "jsCode": "const raw = $json.raw_text ?? $json.chatInput ?? '';\n\n// 이메일 정규식\nlet masked = raw.replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi, '[MASKED_EMAIL]');\n\n// 전화번호 정규식 고도화 (앞뒤로 알파벳이 붙어있는 해시값 내부의 숫자는 무시)\nmasked = masked.replace(/(?<![a-zA-Z0-9])(\\+?\\d{1,3}[-.\\s]?)?(\\(?\\d{2,4}\\)?[-.\\s]?)\\d{3,4}[-.\\s]?\\d{4}(?![a-zA-Z0-9])/g, '[MASKED_PHONE]');\n\nreturn [{ json: { ...$json, masked } }];\n"
      },
