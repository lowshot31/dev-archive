    {
      "parameters": {
        "jsCode": "const agentRes = $input.first().json; // AI Agent 결과물\nconst txid = $('Extract Txid').first().json.prefill_txid || \"N/A\";\n\n// DB에 저장할 고유 케이스 번호 생성\nconst caseId = \"CS-\" + new Date().toISOString().slice(0,10).replace(/-/g,'') + \"-\" + Math.floor(Math.random()*10000);\n\n// 슬랙 Block Kit 조립 (버튼 클릭 시 Etherscan으로 바로 넘어가는 링크 기능 포함!!)\nconst blocks = [\n  {\n    type: \"header\",\n    text: { type: \"plain_text\", text: `🚨 에스컬레이션 티켓: ${caseId}` }\n  },\n  {\n    type: \"section\",\n    fields: [\n      { type: \"mrkdwn\", text: `*TxID:*\\n\\`${txid}\\`` },\n      { type: \"mrkdwn\", text: `*상태:*\\n온체인 성공 / 거래소 미반영` }\n    ]\n  },\n  {\n    type: \"section\",\n    text: { type: \"mrkdwn\", text: `*🤖 AI 상담원 리포트:*\\n${agentRes.output}` }\n  },\n  {\n    type: \"actions\",\n    elements: [\n      {\n        type: \"button\",\n        text: { type: \"plain_text\", text: \"🔍 Etherscan 조회\" },\n        url: `https://etherscan.io/tx/${txid}`, // 대표님이 원하시던 슬랙 밖 자동 스캔 링크!\n        action_id: \"btn_etherscan\"\n      },\n      {\n        type: \"button\",\n        text: { type: \"plain_text\", text: \"나에게 할당 (Assign)\" },\n        style: \"primary\",\n        value: caseId,\n        action_id: \"case_assign\"\n      }\n    ]\n  }\n];\n\nreturn [{\n  json: {\n    case_id: caseId,\n    txid: txid,\n    intent: \"deposit_delay\", // DB용 임시값\n    coin: \"ETH\",\n    network: \"ethereum\",\n    onchain_status: \"confirmed_success\",\n    action: \"manual_review\",\n    slackPayload: {\n      channel: \"C0APL681ETV\", // 대표님 예전 슬랙 채널 ID\n      text: \"새로운 CS 티켓 접수\",\n      blocks: JSON.stringify(blocks)\n    }\n  }\n}];\n"
