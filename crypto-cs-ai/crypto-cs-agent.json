        "jsCode": "const rawText = $json.output || \"\";\n\nlet answer = rawText;\nlet action = \"NONE\";\n\ntry {\n  if (rawText.includes('[ANSWER]')) {\n    answer = rawText.split('[ANSWER]')[1].split('[ACTION]')[0].trim();\n  }\n\n  if (rawText.includes('[ACTION]')) {\n    const actionRaw = rawText.split('[ACTION]')[1].trim();\n    // 핵심 수정: ESCALATE라는 단어가 포함되어 있기만 하면 ESCALATE로 처리\n    action = actionRaw.includes('ESCALATE') ? 'ESCALATE' : 'NONE';\n  }\n} catch (e) {\n  answer = rawText;\n}\n\nreturn [{\n  json: {\n    output: answer,\n    action_type: action,\n    raw_ai_output: rawText\n  }\n}];\n"
      },
