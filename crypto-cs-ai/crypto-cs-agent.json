    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\n// payload가 문자열로 들어오는 케이스 처리\nlet p = body.payload ?? body;\n\nif (typeof p === \"string\") {\n  p = JSON.parse(p);\n}\n\n// 그래도 payload=... 형태(문자열)면 여기로 들어올 수 있음\nif (typeof p === \"object\" && typeof p.payload === \"string\") {\n  p = JSON.parse(p.payload);\n}\n\nconst action = p.actions?.[0];\nif (!action) {\n  throw new Error(`No action found. type=${typeof p} keys=${Object.keys(p).join(\",\")}`);\n}\n\nreturn [{\n  json: {\n    action_id: action.action_id,\n    case_id: action.value,\n    user_id: p.user?.id,\n    channel_id: p.channel?.id,\n    message_ts: p.message?.ts,\n  }\n}];"
